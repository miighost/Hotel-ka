<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template" xml:space="preserve">
    <t t-name="itp_pos_qr_scan.QRScanPopup">
        <div class="modal-dialog">
            <div class="popup popup-qr_scan">
                <div id="preview-container">
                    <video
                        t-ref="preview"
                        class="video_preview"
                        autoplay="true"
                        playsinline="true"
                        t-on-click="onClickCancel"
                    />
                    <t t-if="state.permissionState === 'denied' or state.permissionState === 'error'">
                        <div class="permission-error-overlay">
                            <i class="fa fa-camera fa-3x mb-3 text-warning"/>
                            <h4 class="text-white fw-bold mb-2">Camera Access Required</h4>
                            <p class="text-light mb-4" style="max-width: 340px; font-size: 14px;" t-esc="state.permissionError || 'Please allow camera access in your browser to scan barcodes.'" />
                            <div class="d-flex flex-column flex-sm-row gap-2 w-100 justify-content-center" style="max-width: 340px;">
                                <button class="btn btn-primary btn-lg w-100 py-3 fw-bold" t-on-click="requestCameraPermission">
                                    <i class="fa fa-refresh me-2"/> Allow / Retry Camera
                                </button>
                            </div>
                            <button class="btn btn-link text-white-50 mt-3 text-decoration-none" t-on-click="onClickCancel">
                                <i class="fa fa-times me-1"/> Close
                            </button>
                        </div>
                    </t>
                </div>
                <div class="transparent_sidebar" t-if="state.videoDevices &amp;&amp; state.videoDevices.length > 1">
                    <div class="title">
                        <p class="mb-0">Cameras</p>
                    </div>
                    <div class="body">
                        <div class="mt-2">
                            <t t-foreach="state.videoDevices" t-as="device" t-key="device.deviceId">
                                <button
                                    class="btn btn-sm btn-outline-secondary me-1 mb-1"
                                    t-esc="device.label || ('Camera ' + (device_index + 1))"
                                    t-on-click="() => this.onClickCameraButton(device.deviceId)"
                                />
                            </t>
                        </div>
                    </div>
                </div>
                <div class="note">
                    <p class="mb-0">Point camera at barcode or QR code | Tap video to close</p>
                </div>
            </div>
            <canvas
                t-ref="canvas"
                id="qr-canvas"
                width="800"
                height="600"
                style="width: 800px; height: 600px; display: none;"
            />
        </div>
    </t>
</templates>
