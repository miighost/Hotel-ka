<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Report Action for Room Status Report -->
    <record id="action_report_room_status" model="ir.actions.report">
        <field name="name">Room Status Report</field>
        <field name="model">room.booking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">hotel_management_odoo.report_room_status</field>
        <field name="report_file">hotel_management_odoo.report_room_status</field>
        <field name="binding_model_id" ref="model_room_booking"/>
        <field name="binding_type">report</field>
    </record>

    <!-- QWeb PDF Template for Room Status Report -->
    <template id="report_room_status">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 13px; color: #222; padding-top: 10px;">
                    <div class="row mt16 mb16">
                        <div class="col-12 text-center">
                            <h2 style="font-weight: bold; text-transform: uppercase; color: #111; border-bottom: 2px solid #333; display: inline-block; padding-bottom: 4px;">
                                Room Status Report
                            </h2>
                        </div>
                    </div>
                    <table class="table table-sm table-bordered mt16" style="width: 100%; border: 1px solid #555; border-collapse: collapse; font-size: 12px;">
                        <thead>
                            <tr style="background-color: #e9ecef; text-align: left; font-weight: bold; color: #111;">
                                <th style="border: 1px solid #555; padding: 6px 10px; width: 5%; text-align: left;">SN</th>
                                <th style="border: 1px solid #555; padding: 6px 10px; text-align: left;">Guest Name</th>
                                <th style="border: 1px solid #555; padding: 6px 10px; width: 10%; text-align: left;">Room No</th>
                                <th style="border: 1px solid #555; padding: 6px 10px; width: 16%; text-align: left;">Check In Date</th>
                                <th style="border: 1px solid #555; padding: 6px 10px; width: 14%; text-align: right;">Rate/Night</th>
                                <th style="border: 1px solid #555; padding: 6px 10px; width: 15%; text-align: right;">Today's Balance</th>
                                <th style="border: 1px solid #555; padding: 6px 10px; width: 12%; text-align: left;">Booking No</th>
                                <th style="border: 1px solid #555; padding: 6px 10px; width: 12%; text-align: left;">Nationality</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="grouped_data" t-as="type_group">
                                <t t-set="type_name" t-value="type_group"/>
                                <t t-set="items_list" t-value="grouped_data[type_group]"/>

                                <!-- FULL WIDTH MERGED ROW FOR ROOM TYPE SECTION -->
                                <tr style="background-color: #343a40; color: #ffffff; font-weight: bold;">
                                    <td colspan="8" style="border: 1px solid #555; padding: 6px 10px; font-size: 13px; text-align: left;">
                                        <t t-esc="type_name"/> (Total: <t t-esc="len(items_list)"/> Rooms)
                                    </td>
                                </tr>

                                <t t-set="i" t-value="0"/>
                                <t t-foreach="items_list" t-as="b">
                                    <t t-set="i" t-value="i+1"/>
                                    <t t-set="o" t-value="b['booking']"/>
                                    <tr>
                                        <td style="border: 1px solid #555; padding: 6px 10px; text-align: left;"><t t-esc="i"/></td>
                                        <td style="border: 1px solid #555; padding: 6px 10px; text-align: left;"><strong style="color: #000;"><t t-esc="o.partner_id.name"/></strong></td>
                                        <td style="border: 1px solid #555; padding: 6px 10px; text-align: left;"><t t-esc="o.room_name or ', '.join(o.room_line_ids.mapped('room_id.name')) or '-'"/></td>
                                        <td style="border: 1px solid #555; padding: 6px 10px; text-align: left;"><t t-esc="o.checkin_date and o.checkin_date.strftime('%d-%B-%Y') or '-'"/></td>
                                        <td style="border: 1px solid #555; padding: 6px 10px; text-align: right;">
                                            <t t-esc="'%.2f' % b['nightly_rate']"/>
                                        </td>
                                        <td style="border: 1px solid #555; padding: 6px 10px; text-align: right; font-weight: bold; color: #000;">
                                            <t t-esc="'%.2f' % b['todays_balance']"/>
                                        </td>
                                        <td style="border: 1px solid #555; padding: 6px 10px; text-align: left;"><t t-esc="o.name"/></td>
                                        <td style="border: 1px solid #555; padding: 6px 10px; text-align: left;"><t t-esc="o.partner_id.country_id.name or '-'"/></td>
                                    </tr>
                                </t>
                            </t>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>
