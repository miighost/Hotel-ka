<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Report Action for Reservation Acknowledgement -->
    <record id="action_report_reservation_acknowledgement" model="ir.actions.report">
        <field name="name">Reservation Acknowledgement</field>
        <field name="model">room.booking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">hotel_management_odoo.report_reservation_acknowledgement</field>
        <field name="report_file">hotel_management_odoo.report_reservation_acknowledgement</field>
        <field name="binding_model_id" ref="model_room_booking"/>
        <field name="binding_type">report</field>
    </record>

    <!-- QWeb PDF Template for Reservation Acknowledgement -->
    <template id="report_reservation_acknowledgement">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page" style="font-family: 'Helvetica Neue', Arial, sans-serif; font-size: 13px; color: #222; padding-top: 10px;">
                        
                        <!-- Document Title -->
                        <div class="text-center mb-3">
                            <h3 style="font-weight: bold; text-transform: uppercase; color: #111; letter-spacing: 1px; border-bottom: 2px solid #333; display: inline-block; padding-bottom: 4px;">
                                RESERVATION ACKNOWLEDGEMENT
                            </h3>
                        </div>

                        <!-- Greetings & Intro -->
                        <div style="margin-bottom: 15px; line-height: 1.5;">
                            <p style="margin-bottom: 4px;"><strong>Dear Sir,</strong></p>
                            <p style="margin-bottom: 4px;">Greetings from <strong style="text-transform: uppercase; color: #000;"><t t-esc="o.company_id.name or 'JAZEERA PALACE HOTEL'"/></strong>.</p>
                            <p style="margin-bottom: 4px;">Please let us take this opportunity to thank you for choosing our hotel.</p>
                            <p style="margin-bottom: 8px;">In this regard, we would like to confirm your booking as follows:</p>
                        </div>

                        <!-- Guest & Booking Summary Card -->
                        <div style="border: 1px solid #777; border-radius: 8px; padding: 12px; margin-bottom: 18px; background-color: #fcfcfc;">
                            <div class="row">
                                <!-- Left Column -->
                                <div class="col-6">
                                    <table style="width: 100%; border-collapse: separate; border-spacing: 0 4px;">
                                        <tr>
                                            <td style="width: 130px; font-weight: bold;">Guest Name</td>
                                            <td style="width: 12px;">:</td>
                                            <td style="font-weight: bold; color: #000;"><t t-esc="o.partner_id.name"/></td>
                                        </tr>
                                        <tr>
                                            <td style="font-weight: bold;">Nationality</td>
                                            <td>:</td>
                                            <td><t t-esc="o.partner_id.country_id.name or '-'"/></td>
                                        </tr>
                                        <tr>
                                            <td style="font-weight: bold;">Reservation No</td>
                                            <td>:</td>
                                            <td style="font-weight: bold; color: #111;"><t t-esc="o.name"/></td>
                                        </tr>
                                        <tr>
                                            <td style="font-weight: bold;">Reservation Date</td>
                                            <td>:</td>
                                            <td><t t-esc="o.date_order and o.date_order.strftime('%d-%B-%Y') or '-'"/></td>
                                        </tr>
                                        <tr>
                                            <td style="font-weight: bold;">City Ledger</td>
                                            <td>:</td>
                                            <td><t t-esc="o.partner_id.parent_id.name or '-'"/></td>
                                        </tr>
                                        <tr>
                                            <td style="font-weight: bold;">C/O</td>
                                            <td>:</td>
                                            <td><t t-esc="o.partner_id.company_name or '-'"/></td>
                                        </tr>
                                        <tr>
                                            <td style="font-weight: bold;">Pax</td>
                                            <td>:</td>
                                            <td><t t-esc="o.room_line_ids and o.room_line_ids[0].room_id.num_person or 1"/></td>
                                        </tr>
                                    </table>
                                </div>

                                <!-- Right Column -->
                                <div class="col-6">
                                    <table style="width: 100%; border-collapse: separate; border-spacing: 0 4px;">
                                        <tr>
                                            <td style="width: 130px; font-weight: bold;">From Date</td>
                                            <td style="width: 12px;">:</td>
                                            <td style="font-weight: bold;"><t t-esc="o.checkin_date and o.checkin_date.strftime('%d-%B-%Y') or '-'"/></td>
                                        </tr>
                                        <tr>
                                            <td style="font-weight: bold;">To Date</td>
                                            <td>:</td>
                                            <td style="font-weight: bold;"><t t-esc="o.checkout_date and o.checkout_date.strftime('%d-%B-%Y') or '-'"/></td>
                                        </tr>
                                        <tr>
                                            <td style="font-weight: bold;">No of Days</td>
                                            <td>:</td>
                                            <td><t t-esc="o.duration or 1"/> Day(s)</td>
                                        </tr>
                                        <tr>
                                            <td style="font-weight: bold;">Status</td>
                                            <td>:</td>
                                            <td><span style="font-weight: bold; color: #28a745;">Confirmed</span></td>
                                        </tr>
                                        <tr>
                                            <td style="font-weight: bold;">Payment Type</td>
                                            <td>:</td>
                                            <td><t t-esc="o.pricelist_id.name or '-'"/></td>
                                        </tr>
                                        <tr>
                                            <td style="font-weight: bold;">Adv. Amount</td>
                                            <td>:</td>
                                            <td>0.00</td>
                                        </tr>
                                        <tr>
                                            <td style="font-weight: bold;">Plan</td>
                                            <td>:</td>
                                            <td style="font-weight: bold; color: #000;"><t t-esc="plan_labels.get(o.plan, o.plan or 'BB')"/></td>
                                        </tr>
                                    </table>
                                </div>
                            </div>
                        </div>

                        <!-- Room Details Table -->
                        <div style="margin-bottom: 18px;">
                            <table class="table table-bordered table-sm" style="width: 100%; border: 1px solid #777; border-collapse: collapse;">
                                <thead>
                                    <tr style="background-color: #eee; text-align: center; font-weight: bold;">
                                        <th style="border: 1px solid #777; padding: 6px;">Room Type</th>
                                        <th style="border: 1px solid #777; padding: 6px; width: 20%;">No of Rooms</th>
                                        <th style="border: 1px solid #777; padding: 6px; width: 25%; text-align: right;">Room Rate</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="o.room_line_ids" t-as="r">
                                        <tr>
                                            <td style="border: 1px solid #777; padding: 6px;">
                                                <t t-esc="r.room_id.room_type and dict(r.room_id._fields['room_type'].selection).get(r.room_id.room_type) or r.room_id.name"/>
                                                <t t-if="r.room_id.name"> (<t t-esc="r.room_id.name"/>)</t>
                                            </td>
                                            <td style="border: 1px solid #777; padding: 6px; text-align: center;">1</td>
                                            <td style="border: 1px solid #777; padding: 6px; text-align: right; font-weight: bold;">
                                                <t t-esc="f'{r.price_unit:,.2f}'"/>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>

                        <!-- Remarks if present -->
                        <t t-if="o.description">
                            <div style="margin-bottom: 15px; padding: 8px; border: 1px dashed #aaa; background-color: #fff8dc;">
                                <strong>Remarks:</strong> <t t-esc="o.description"/>
                            </div>
                        </t>

                        <!-- Cancellation Policy Box -->
                        <div style="border: 1px solid #aaa; border-radius: 6px; padding: 10px 14px; margin-bottom: 30px; background-color: #fafafa; font-size: 11px; line-height: 1.4;">
                            <div style="font-weight: bold; text-decoration: underline; margin-bottom: 4px; color: #111;">Cancellation Policy:</div>
                            <ul style="margin: 0; padding-left: 18px; color: #444;">
                                <li>Non-Guaranteed reservation will be kept till 16:00 hrs on the day of arrival, unless informed about late arrival.</li>
                                <li>Guest check-in before morning 06:00am will be charged from the previous day.</li>
                                <li>The hotel check-in is 14:00 hrs and out time is 12:00 noon, early check-in and late checkout is available on request, subject to room availability and prior approval from the Front Office Manager.</li>
                                <li>In case of no show one day will be charged and cancellation before 48 hrs there is no charge.</li>
                            </ul>
                        </div>

                        <!-- Signatures Footer -->
                        <div style="margin-top: 40px; padding-top: 10px;">
                            <div class="row">
                                <div class="col-6 text-center">
                                    <div style="border-bottom: 1px solid #000; width: 70%; margin: 0 auto 6px auto;"></div>
                                    <strong>Guest Signatory</strong>
                                </div>
                                <div class="col-6 text-center">
                                    <div style="border-bottom: 1px solid #000; width: 70%; margin: 0 auto 6px auto;"></div>
                                    <strong>Authorized Signatory</strong>
                                </div>
                            </div>
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
