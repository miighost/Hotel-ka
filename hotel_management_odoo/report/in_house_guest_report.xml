<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Report Action for In-House Guest List -->
    <record id="action_report_in_house_guest" model="ir.actions.report">
        <field name="name">In House Guest List</field>
        <field name="model">room.booking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">hotel_management_odoo.report_in_house_guest</field>
        <field name="report_file">hotel_management_odoo.report_in_house_guest</field>
        <field name="binding_model_id" ref="model_room_booking"/>
        <field name="binding_type">report</field>
    </record>

    <!-- QWeb PDF Template for In-House Guest List -->
    <template id="report_in_house_guest">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 13px; color: #222; padding-top: 10px;">
                    <div class="row mt16 mb16">
                        <div class="col-12 text-center">
                            <h2 style="font-weight: bold; text-transform: uppercase; color: #111; border-bottom: 2px solid #333; display: inline-block; padding-bottom: 4px;">
                                In-House Guest List
                            </h2>
                        </div>
                    </div>
                    <table class="table table-sm table-bordered mt16" style="width: 100%; border: 1px solid #555; border-collapse: collapse; font-size: 12px;">
                        <thead>
                            <tr style="background-color: #e9ecef; text-align: center; font-weight: bold; color: #111;">
                                <th style="border: 1px solid #555; padding: 6px; width: 5%;">SN</th>
                                <th style="border: 1px solid #555; padding: 6px;">Guest Name</th>
                                <th style="border: 1px solid #555; padding: 6px; width: 10%;">Room No</th>
                                <th style="border: 1px solid #555; padding: 6px; width: 14%;">Check In</th>
                                <th style="border: 1px solid #555; padding: 6px; width: 14%;">Dep Date</th>
                                <th style="border: 1px solid #555; padding: 6px; width: 16%;">Meal Plan</th>
                                <th style="border: 1px solid #555; padding: 6px; width: 12%;">Nationality</th>
                                <th style="border: 1px solid #555; padding: 6px; width: 12%;">City Ledger</th>
                                <th style="border: 1px solid #555; padding: 6px; width: 12%; text-align: right;">Room Rate</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-set="i" t-value="0"/>
                            <t t-foreach="docs" t-as="o">
                                <t t-set="i" t-value="i+1"/>
                                <tr>
                                    <td class="text-center" style="border: 1px solid #555; padding: 6px;"><t t-esc="i"/></td>
                                    <td style="border: 1px solid #555; padding: 6px;"><strong style="color: #000;"><t t-esc="o.partner_id.name"/></strong></td>
                                    <td style="border: 1px solid #555; padding: 6px; text-align: center;"><t t-esc="o.room_name or ', '.join(o.room_line_ids.mapped('room_id.name')) or '-'"/></td>
                                    <td class="text-center" style="border: 1px solid #555; padding: 6px;"><t t-esc="o.checkin_date and o.checkin_date.strftime('%d-%B-%Y') or '-'"/></td>
                                    <td class="text-center" style="border: 1px solid #555; padding: 6px;"><t t-esc="o.checkout_date and o.checkout_date.strftime('%d-%B-%Y') or '-'"/></td>
                                    <td style="border: 1px solid #555; padding: 6px; font-weight: 600;"><t t-esc="plan_labels.get(o.plan, o.plan or '-')"/></td>
                                    <td style="border: 1px solid #555; padding: 6px;"><t t-esc="o.partner_id.country_id.name or '-'"/></td>
                                    <td style="border: 1px solid #555; padding: 6px;"><t t-esc="o.partner_id.parent_id.name or '-'"/></td>
                                    <td style="border: 1px solid #555; padding: 6px; text-align: right; font-weight: bold;">
                                        <t t-set="room_rate" t-value="sum(o.room_line_ids.mapped('price_unit')) if o.room_line_ids else 0.0"/>
                                        <t t-esc="'%.2f' % room_rate"/>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>
