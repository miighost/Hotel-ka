<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Report Action for Room Details Report -->
    <record id="action_report_room_details" model="ir.actions.report">
        <field name="name">Room Details Report</field>
        <field name="model">hotel.room</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">hotel_management_odoo.report_room_details</field>
        <field name="report_file">hotel_management_odoo.report_room_details</field>
        <field name="binding_model_id" ref="model_hotel_room"/>
        <field name="binding_type">report</field>
    </record>

    <!-- QWeb PDF Template for Room Details Report -->
    <template id="report_room_details">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 13px; color: #222; padding-top: 10px;">
                    <div class="row mt16 mb16">
                        <div class="col-12 text-center">
                            <h2 style="font-weight: bold; text-transform: uppercase; color: #111; border-bottom: 2px solid #333; display: inline-block; padding-bottom: 4px;">
                                Room Details Report
                            </h2>
                        </div>
                    </div>

                    <table class="table table-sm table-bordered mt16" style="width: 100%; border: 1px solid #555; border-collapse: collapse; font-size: 12px;">
                        <thead>
                            <tr style="background-color: #e9ecef; text-align: left; font-weight: bold; color: #111;">
                                <th style="border: 1px solid #555; padding: 6px 10px; width: 10%; text-align: left;">SN</th>
                                <th style="border: 1px solid #555; padding: 6px 10px; width: 40%; text-align: left;">Room No</th>
                                <th style="border: 1px solid #555; padding: 6px 10px; width: 25%; text-align: left;">No Of Bed</th>
                                <th style="border: 1px solid #555; padding: 6px 10px; width: 25%; text-align: left;">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="grouped_rooms" t-as="type_group">
                                <t t-set="type_name" t-value="type_group"/>
                                <t t-set="rooms_list" t-value="grouped_rooms[type_group]"/>

                                <!-- SINGLE ROW ROOM TYPE SECTION -->
                                <tr style="background-color: #343a40; color: #ffffff; font-weight: bold;">
                                    <td colspan="4" style="border: 1px solid #555; padding: 6px 10px; font-size: 13px; text-align: left;">
                                        <t t-esc="type_name"/> (Total: <t t-esc="len(rooms_list)"/> Rooms)
                                    </td>
                                </tr>

                                <!-- Room rows under this section -->
                                <t t-set="sn" t-value="0"/>
                                <t t-foreach="rooms_list" t-as="o">
                                    <t t-set="sn" t-value="sn + 1"/>
                                    <tr>
                                        <td style="border: 1px solid #555; padding: 6px 10px; text-align: left;"><t t-esc="sn"/></td>
                                        <td style="border: 1px solid #555; padding: 6px 10px; text-align: left;"><strong style="color: #000;"><t t-esc="o.name"/></strong></td>
                                        <td style="border: 1px solid #555; padding: 6px 10px; text-align: left; font-weight: bold;"><t t-esc="o.num_bed"/></td>
                                        <td style="border: 1px solid #555; padding: 6px 10px; text-align: left;">
                                            <span t-field="o.status" style="font-weight: 600; text-transform: uppercase;"/>
                                        </td>
                                    </tr>
                                </t>
                            </t>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>
