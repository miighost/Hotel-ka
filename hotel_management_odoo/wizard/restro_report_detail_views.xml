<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--    In-House Guest Report Detail form view-->
    <record id="restro_report_detail_view_form" model="ir.ui.view">
        <field name="name">restro.report.detail.view.form</field>
        <field name="model">restro.report.detail</field>
        <field name="arch" type="xml">
            <form name="report">
                <div class="alert alert-info" role="alert">
                    Generates a report of all currently <b>In-House Checked-In Guests</b> along with their <b>Room Number</b> and <b>Board Type</b> (BB, HB, FB, RO).
                </div>
                <footer>
                    <button name="action_restro_report_pdf" type="object"
                            class="btn-primary">
                        <i class="fa fa-download mr-2"/>
                        Download PDF
                    </button>
                    <button name="action_restro_report_excel" type="object"
                            class="btn-primary">
                        <i class="fa fa-download mr-2"/>
                        Download XLS
                    </button>
                    <button special="cancel" string="Cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <!--    In-House Guest Report Menu Action-->
    <record id="restro_report_detail_action" model="ir.actions.act_window">
        <field name="name">In-House Guest Report</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">restro.report.detail</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="restro_report_detail_view_form"/>
        <field name="target">new</field>
    </record>
</odoo>
