<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_config_view_form_inherit_mobile_api" model="ir.ui.view">
        <field name="name">pos.config.form.inherit.mobile.api</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <h2>Mobile App Configuration</h2>
                <div class="row mt16 o_settings_container">
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane">
                            <field name="is_active_for_mobile"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="is_active_for_mobile"/>
                            <div class="text-muted">
                                Show this branch in the mobile app.
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_right_pane">
                            <label for="delivery_radius_km"/>
                            <field name="delivery_radius_km"/>
                            <label for="branch_latitude" class="mt16"/>
                            <field name="branch_latitude"/>
                            <label for="branch_longitude" class="mt16"/>
                            <field name="branch_longitude"/>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>