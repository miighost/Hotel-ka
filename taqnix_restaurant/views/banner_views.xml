<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_resto_app_banner_list" model="ir.ui.view">
        <field name="name">resto.app.banner.list</field>
        <field name="model">resto.app.banner</field>
        <field name="arch" type="xml">
            <list string="App Banners">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="subtitle"/>
                <field name="pos_config_id" placeholder="All Branches"/>
                <field name="hex_color" widget="color"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_resto_app_banner_form" model="ir.ui.view">
        <field name="name">resto.app.banner.form</field>
        <field name="model">resto.app.banner</field>
        <field name="arch" type="xml">
            <form string="App Banner">
                <sheet>
                    <field name="image_1920" widget="image" class="oe_avatar"
                           options="{'preview_image': 'image_1920'}"/>

                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="e.g. Ramadan Iftar Combo"/>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name="subtitle" placeholder="e.g. Get 20% OFF on family meals"/>
                            <field name="pos_config_id" options="{'no_create': True}"/>
                            <field name="hex_color" widget="color"/>
                            <field name="image_ar_1920"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>

                    <group string="On Click Action">
                        <group>
                            <field name="click_action" widget="radio" options="{'horizontal': true}"/>
                        </group>

                        <group>
                            <field name="target_id"
                                   invisible="click_action not in ('category', 'product')"
                                   required="click_action in ('category', 'product')"
                                   help="Enter the Database ID of the Food Item or Category"/>

                            <field name="target_url"
                                   placeholder="https://..."
                                   invisible="click_action != 'url'"
                                   required="click_action == 'url'"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_resto_app_banner_search" model="ir.ui.view">
        <field name="name">resto.app.banner.search</field>
        <field name="model">resto.app.banner</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="subtitle"/>
                <field name="pos_config_id"/>
                <filter string="Archived" name="archived" domain="[('active', '=', False)]"/>

                <!--<group expand="0" string="Group By">
                    <filter string="Branch" name="group_by_branch" context="{'group_by':'pos_config_id'}"/>
                </group>-->
            </search>
        </field>
    </record>

    <record id="action_resto_app_banner" model="ir.actions.act_window">
        <field name="name">App Banners</field>
        <field name="res_model">resto.app.banner</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Restaurant Mobile App Banner
            </p>
            <p>
                Banners will appear on the home screen of the Flutter app. You can assign them to specific branches or show them to everyone!
            </p>
        </field>
    </record>

    <menuitem id="menu_resto_app_root" name="Mobile App" sequence="50" web_icon="point_of_sale,static/description/icon.png"/>

    <menuitem id="menu_resto_app_banner"
              parent="menu_resto_app_root"
              action="action_resto_app_banner"
              sequence="1"/>
</odoo>