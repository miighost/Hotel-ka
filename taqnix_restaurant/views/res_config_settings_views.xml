<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_mobile_api" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.mobile.api</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='point_of_sale']" position="inside">

                <block title="Mobile App Configuration" id="mobile_app_api_settings">

                    <setting id="pos_mobile_active_setting" help="Show this branch in the mobile app.">
                        <field name="pos_is_active_for_mobile"/>
                    </setting>

                    <setting id="pos_mobile_radius_setting" string="Delivery Radius (KM)" help="Maximum delivery distance.">
                        <field name="pos_delivery_radius_km"/>
                        <div class="mt16">
                            <label for="pos_branch_latitude" string="Latitude" class="col-4 o_light_label"/>
                            <field name="pos_branch_latitude"/>
                        </div>
                        <div class="mt8">
                            <label for="pos_branch_longitude" string="Longitude" class="col-4 o_light_label"/>
                            <field name="pos_branch_longitude"/>
                        </div>
                    </setting>

                    <setting id="pos_mobile_operations_setting" string="Order Rules" help="Rules for mobile app orders.">
                        <div class="mt8">
                            <label for="pos_minimum_order_amount" string="Min Order Amount" class="col-5 o_light_label"/>
                            <field name="pos_minimum_order_amount"/>
                        </div>
                        <div class="mt8">
                            <label for="pos_delivery_fee" string="Delivery Fee" class="col-5 o_light_label"/>
                            <field name="pos_delivery_fee"/>
                        </div>
                        <div class="mt8">
                            <label for="pos_preparation_time_minutes" string="Prep Time (Min)" class="col-5 o_light_label"/>
                            <field name="pos_preparation_time_minutes"/>
                        </div>
                    </setting>

                    <setting id="pos_mobile_contact_setting" string="Support Contact" help="WhatsApp number for this branch.">
                        <field name="pos_branch_whatsapp" widget="phone"/>
                    </setting>

                    <setting id="pos_mobile_app_bar_banner_setting" string="App Bar Banner" help="Upload the background image for the mobile app's header.">
                        <div class="mt8">
                            <field name="pos_mobile_app_bar_banner" widget="image" class="w-100"/>
                        </div>
                    </setting>

                    <setting id="pos_mobile_social_setting" string="Social &amp; Review Links" help="Links to show in the app's profile/support page.">
                        <div class="mt8">
                            <label for="pos_mobile_google_review_link" string="Google Review" class="col-4 o_light_label"/>
                            <field name="pos_mobile_google_review_link" widget="url"/>
                        </div>
                        <div class="mt8">
                            <label for="pos_mobile_google_business_link" string="Google Business" class="col-4 o_light_label"/>
                            <field name="pos_mobile_google_business_link" widget="url"/>
                        </div>
                        <div class="mt8">
                            <label for="pos_mobile_snapchat_link" string="Snapchat" class="col-4 o_light_label"/>
                            <field name="pos_mobile_snapchat_link" widget="url"/>
                        </div>
                        <div class="mt8">
                            <label for="pos_mobile_instagram_link" string="Instagram" class="col-4 o_light_label"/>
                            <field name="pos_mobile_instagram_link" widget="url"/>
                        </div>
                        <div class="mt8">
                            <label for="pos_mobile_tiktok_link" string="TikTok" class="col-4 o_light_label"/>
                            <field name="pos_mobile_tiktok_link" widget="url"/>
                        </div>
                        <div class="mt8">
                            <label for="pos_mobile_facebook_link" string="Facebook" class="col-4 o_light_label"/>
                            <field name="pos_mobile_facebook_link" widget="url"/>
                        </div>
                    </setting>

                </block>

            </xpath>
        </field>
    </record>
</odoo>