<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <!-- Always-available Print KOT button on the POS Action / Control Buttons bar -->
    <t t-name="ss_print_pos_kitchen_receipt.ControlButtons" t-inherit="point_of_sale.ControlButtons" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('control-buttons')]" position="inside">
            <button class="control-button btn btn-light rounded-0 fw-bold border-end d-flex align-items-center justify-content-center py-2 px-3 me-1"
                    style="font-size: 15px; font-weight: bold; cursor: pointer;"
                    t-on-click="() => (this.onClickManualKotButton ? this.onClickManualKotButton() : (this.pos &amp;&amp; this.pos.forceBrowserPrintDialog &amp;&amp; this.pos.forceBrowserPrintDialog()))">
                <i class="fa fa-print me-1 text-primary"/> Print KOT
            </button>
        </xpath>
    </t>

</templates>





