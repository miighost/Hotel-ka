<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_taqnix_app_client_form" model="ir.ui.view">
        <field name="name">taqnix.app.client.form</field>
        <field name="model">taqnix.app.client</field>
        <field name="arch" type="xml">
            <form string="Taqnix App Builder">
                <header>
                    <button name="action_fetch_details" type="object" string="1. Fetch Details" class="oe_highlight"/>
                    <button name="action_save_details" type="object" string="2. Save &amp; Sync to API" class="oe_highlight"/>
                    <button name="action_build_android" type="object" string="3. Build Android" class="btn-success" invisible="state in ['pending', 'in_progress']"/>
                    <button name="action_refresh_status" type="object" string="↻ Check Live Status" class="btn-info" invisible="state not in ['pending', 'in_progress']"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,pending,in_progress,completed,failed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="App Name (e.g. My Awesome App)"/>
                        </h1>
                    </div>

                    <group>
                     <group string="Authentication">
                            <field name="site_url" widget="url" placeholder="https://www.mywebsite.com"/>
                            <field name="database_name" placeholder="e.g., my_odoo_database"/>
                            <field name="license_key" placeholder="Enter your secret product key"/>
                            <field name="remote_build_id" placeholder="Generated automatically upon fetch"/>
                        </group>

                        <group string="Contact Info">
                            <field name="email" placeholder="support@mycompany.com"/>
                            <field name="phone" placeholder="+1 (555) 019-2834"/>
                            <field name="country_code" placeholder="e.g. US, IN, GB"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="App Configuration">
                            <group>
                                <group>
                                    <field name="package_name" placeholder="com.mycompany.myapp"/>
                                    <field name="build_type"/>
                                    <field name="splash_background_color" widget="color" placeholder="#FFFFFF"/>
                                </group>
                                <group string="Google Maps Integration">
                                    <field name="google_maps_api_key" placeholder="AIzaSyA1b2C3d4..."/>
                                </group>

                                <group string="Facebook Settings">
                                    <field name="facebook_app_name" placeholder="My Facebook Dev App"/>
                                    <field name="facebook_app_id" placeholder="123456789012345"/>
                                    <field name="facebook_client_token" placeholder="a1b2c3d4e5f6..."/>
                                </group>
                                <group string="Assets &amp; Files">
                                    <field name="logo_file" filename="logo_file_name" widget="image" options="{'size': [100, 100]}"/>
                                    <field name="logo_file_name" invisible="1"/>

                                    <field name="icon_file" filename="icon_file_name" widget="image" options="{'size': [100, 100]}"/>
                                    <field name="icon_file_name" invisible="1"/>

                                    <field name="splash_file" filename="splash_file_name" widget="image" options="{'size': [100, 100]}"/>
                                    <field name="splash_file_name" invisible="1"/>

                                    <field name="google_service_json" filename="google_service_json_name"/>
                                    <field name="google_service_json_name" invisible="1"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>

                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_taqnix_app_client_list" model="ir.ui.view">
        <field name="name">taqnix.app.client.list</field>
        <field name="model">taqnix.app.client</field>
        <field name="arch" type="xml">
         <list string="Taqnix Apps">
                <field name="name"/>
                <field name="site_url"/>
                <field name="package_name"/>
                <field name="build_type"/>

                <field name="state"
                       widget="badge"
                       decoration-success="state == 'completed'"
                       decoration-danger="state == 'failed'"
                       decoration-warning="state == 'in_progress'"
                       decoration-muted="state == 'pending' or state == 'draft'"/>
            </list>

        </field>
    </record>

    <record id="action_taqnix_app_client" model="ir.actions.act_window">
        <field name="name">Taqnix App Builder</field>
        <field name="res_model">taqnix.app.client</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="taqnix_builder_menu_root" name="App Builder" sequence="20" web_icon="taqnix_app_builder,static/description/icon.png"/>
    <menuitem id="menu_taqnix_app_apps" name="Applications" parent="taqnix_builder_menu_root" action="action_taqnix_app_client" sequence="50"/>

</odoo>